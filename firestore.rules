rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'ppk.bm.30@gmail.com';
    }
    function validNewOrder(orderId) {
      let data = request.resource.data;
      let customer = data.customer;
      return request.auth != null
        && data.keys().hasAll(['customerUid', 'customerEmail', 'customer', 'items', 'total', 'currency', 'paymentMethod', 'paymentStatus', 'paymentProofPath', 'orderStatus', 'createdAt'])
        && data.keys().hasOnly(['customerUid', 'customerEmail', 'customer', 'items', 'total', 'currency', 'paymentMethod', 'paymentStatus', 'paymentProofPath', 'orderStatus', 'createdAt'])
        && data.customerUid == request.auth.uid
        && data.customerEmail == request.auth.token.email
        && customer is map
        && customer.keys().hasAll(['name', 'phone', 'address', 'note'])
        && customer.keys().hasOnly(['name', 'phone', 'address', 'note'])
        && customer.name is string && customer.name.size() >= 2 && customer.name.size() <= 100
        && customer.phone is string && customer.phone.size() >= 5 && customer.phone.size() <= 32
        && customer.address is string && customer.address.size() >= 4 && customer.address.size() <= 500
        && customer.note is string && customer.note.size() <= 300
        && data.items is list && data.items.size() > 0 && data.items.size() <= 10
        && data.total is int && data.total > 0 && data.total <= 100000000
        && data.currency == 'LAK'
        && data.paymentMethod == 'BCEL QR'
        && data.paymentStatus in ['awaiting_payment', 'awaiting_proof_upload']
        && data.paymentProofPath is string
        && ((data.paymentStatus == 'awaiting_payment' && data.paymentProofPath == '')
          || (data.paymentStatus == 'awaiting_proof_upload' && data.paymentProofPath == 'payment-proofs/' + orderId + '/receipt'))
        && data.orderStatus == 'new'
        && data.createdAt == request.time;
    }
    match /orders/{orderId} {
      allow create: if request.auth != null && validNewOrder(orderId);
      allow get, list: if isAdmin();
      allow update: if (
          isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['orderStatus', 'paymentStatus'])
          && request.resource.data.orderStatus in ['new', 'confirmed', 'preparing', 'shipped', 'completed', 'cancelled']
          && request.resource.data.paymentStatus in ['awaiting_payment', 'awaiting_proof_upload', 'proof_submitted', 'paid', 'rejected']
        ) || (
          request.auth != null
          && request.auth.uid == resource.data.customerUid
          && resource.data.paymentStatus == 'awaiting_proof_upload'
          && request.resource.data.paymentStatus == 'proof_submitted'
          && request.resource.data.paymentProofPath == resource.data.paymentProofPath
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentStatus'])
        );
      allow delete: if false;
    }
  }
}
